        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\nimport xml.etree.ElementTree as ET\n\nNS = {\"anibt\": \"https://anibt.net/xmlns/rss/1.0/\"}\n\n\ndef text(item, tag):\n    \"\"\"Read a direct child element's text.\"\"\"\n    child = item.find(tag, NS)\n    if child is None or child.text is None:\n        return \"\"\n    return child.text.strip()\n\n\ndef human_size(value):\n    \"\"\"Format a byte count as a human readable size.\"\"\"\n    try:\n        size = float(value)\n    except (TypeError, ValueError):\n        return \"\"\n    for unit in (\"B\", \"KB\", \"MB\", \"GB\", \"TB\"):\n        if size < 1024 or unit == \"TB\":\n            return f\"{int(size)} B\" if unit == \"B\" else f\"{size:.2f} {unit}\"\n        size /= 1024.0\n    return \"\"\n\n\ndef execute(node_id, node_data, context):\n    \"\"\"Parse the AniBT magnets RSS feed into search results.\"\"\"\n    status = context.get(\"anibt_status\", 200)\n    if not 200 <= status < 300:\n        raise ValueError(f\"AniBT request failed with HTTP {status}\")\n\n    raw = context.get(\"response\") or \"\"\n    try:\n        root = ET.fromstring(raw)\n    except ET.ParseError as exc:\n        raise ValueError(\"AniBT did not return a valid RSS feed\") from exc\n\n    results = []\n    for item in root.iter(\"item\"):\n        release_id = text(item, \"anibt:releaseId\") or text(item, \"guid\")\n        title = text(item, \"title\")\n        if not release_id or not title:\n            continue\n\n        misc = []\n        episode = text(item, \"anibt:episodeKey\") or text(item, \"anibt:episode\")\n        if episode:\n            misc.append(f\"第{episode}集\" if episode.isdigit() else f\"集 {episode}\")\n        for key in (\"resolution\", \"subtitle\", \"format\"):\n            value = text(item, f\"anibt:{key}\")\n            if value and value.upper() != \"NONE\":\n                misc.append(value)\n        misc.extend(\n            tag.text.strip()\n            for tag in item.findall(\"anibt:customTag\", NS)\n            if tag is not None and tag.text\n        )\n\n        results.append({\n            \"id\": release_id,\n            \"title\": title,\n            \"link\": text(item, \"anibt:torrentUrl\") or text(item, \"anibt:releasePageUrl\"),\n            \"size\": human_size(text(item, \"anibt:fileSize\")),\n            \"misc\": \" \\u00b7 \".join(dict.fromkeys(m for m in misc if m)),\n            \"category\": \"番剧\",\n            \"uploader\": text(item, \"anibt:groupName\"),\n            \"uploaded_at\": text(item, \"pubDate\"),\n        })\n\n    context[\"search_result\"] = json.dumps({\n        \"total\": None,\n        \"totalPages\": None,\n        \"page\": 1,\n        \"items\": results,\n    })\n"
          }
        },
