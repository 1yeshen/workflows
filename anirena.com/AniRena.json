{
  "name": "AniRena",
  "icon": "data:image/webp;base64,",
  "description": "\u300cAniRena\u300d\u8d44\u6e90\u641c\u7d22",
  "category": "indexer",
  "revision": 1791126398,
  "definition": {
    "nodes": [
      {
        "id": "ar-search",
        "type": "node",
        "position": {
          "x": 210,
          "y": 210
        },
        "origin": [
          0.5,
          0
        ],
        "data": {
          "$schema": "search_start",
          "config": "display:\n  page_size: 100\n  view_modes:\n  - table\nkeyword:\n  global: true\n  required: false\nfilters:\n  sort:\n    type: select\n    label: \u6392\u5e8f\n    options:\n      date: \u53d1\u5e03\u65f6\u95f4\n      name: \u540d\u79f0\n      size: \u6587\u4ef6\u5927\u5c0f\n      downloaded: \u5b8c\u6210\u6b21\u6570\n      uploader: \u4e0a\u4f20\u8005\n  order:\n    type: radio\n    label: \u987a\u5e8f\n    options:\n      desc: \u964d\u5e8f\n      asc: \u5347\u5e8f\n"
        }
      },
      {
        "id": "ar-list",
        "type": "node",
        "position": {
          "x": 820,
          "y": 40
        },
        "origin": [
          0.5,
          0
        ],
        "data": {
          "$schema": "http",
          "client": "httpx",
          "timeout": 30,
          "method": "GET",
          "url": "https://www.anirena.com/?q={{keyword|default('')|urlencode}}&page={{page_num|default(1)}}&per_page=100&sort={{sort|default('date',true)}}&order={{order|default('desc',true)}}",
          "body": "",
          "headers": [
            {
              "key": "User-Agent",
              "value": "Mozilla/5.0"
            },
            {
              "key": "Referer",
              "value": "https://www.anirena.com/"
            }
          ],
          "formatter": "{% set rows = response.text|xpath_all('//table[contains(@class,\"tl-table\")]//tr[@data-torrent-id]') %}\n{\n  \"status\": {{ response.status_code }},\n  \"valid_page\": {{ response.text|xpath('boolean(//*[@id=\"page-home\"])')|tojson }},\n  \"pagination\": {{ response.text|xpath_all('//nav[@id=\"tl-pagination-top\"]/a/@href')|tojson }},\n  \"items\": [\n{% for row in rows %}\n    {\n      \"id\": {{ row|xpath('./@data-torrent-id')|tojson }},\n      \"title\": {{ (row|xpath('string(.//a[@class=\"tl-group\"])') + ' ' + row|xpath('string(.//a[contains(@class,\"tl-torrent-name\")])'))|trim|tojson }},\n      \"link\": {{ ('https://www.anirena.com' + row|xpath('(.//a[contains(@href,\".torrent\")]/@href)[1]'))|tojson }},\n      \"size\": {{ row|xpath('string(./td[contains(@class,\"col-size\")])')|trim|tojson }},\n      \"category\": {{ row|xpath('./td[contains(@class,\"col-cat\")]/@title')|tojson }},\n      \"uploader\": {{ row|xpath('(.//a[@data-uploader]/@data-uploader)[1]')|tojson }},\n      \"uploaded_at\": {{ (row|xpath('(.//*[@data-utc]/@data-utc)[1]') + ' UTC')|tojson }},\n      \"misc\": {{ ('\u2191 ' + row|xpath('string(./td[contains(@class,\"col-se\")]/span[1])') + ' / \u2193 ' + row|xpath('string(./td[contains(@class,\"col-le\")]/span[1])'))|tojson }}\n    }{{ ',' if not loop.last }}\n{% endfor %}\n  ]\n}\n"
        }
      },
      {
        "id": "ar-result",
        "type": "node",
        "position": {
          "x": 1570,
          "y": 190
        },
        "origin": [
          0.5,
          0
        ],
        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "from urllib.parse import parse_qs, urlsplit\n\n\ndef execute(node_id, node_data, context):\n    \"\"\"Validate the listing and expose its results and pagination.\n\n    Args:\n        node_id: The workflow node identifier.\n        node_data: The node configuration.\n        context: The listing response and search parameters.\n\n    Raises:\n        ValueError: If the response is an error or an unexpected page.\n    \"\"\"\n    if context.get(\"status\") != 200 or not context.get(\"valid_page\"):\n        raise ValueError(\"AniRena did not return a torrent listing\")\n    page = max(1, int(context.get(\"page_num\") or 1))\n    pages = [page]\n    for href in context.get(\"pagination\", []):\n        value = parse_qs(urlsplit(href).query).get(\"page\", [\"1\"])[0]\n        if value.isdigit():\n            pages.append(int(value))\n    context[\"result\"] = {\"items\": context.get(\"items\", []), \"totalPages\": max(pages)}\n"
          }
        }
      },
      {
        "id": "ar-end",
        "type": "node",
        "position": {
          "x": 2260,
          "y": 320
        },
        "origin": [
          0.5,
          0
        ],
        "data": {
          "$schema": "search_end",
          "response": "{{ result|tojson }}"
        }
      }
    ],
    "edges": [
      {
        "id": "xy-edge__ar-searchoutput-ar-listinput",
        "source": "ar-search",
        "sourceHandle": "output",
        "target": "ar-list",
        "targetHandle": "input"
      },
      {
        "id": "xy-edge__ar-listoutput-ar-resultinput",
        "source": "ar-list",
        "sourceHandle": "output",
        "target": "ar-result",
        "targetHandle": "input"
      },
      {
        "id": "xy-edge__ar-resultoutput-ar-endinput",
        "source": "ar-result",
        "sourceHandle": "output",
        "target": "ar-end",
        "targetHandle": "input"
      }
    ]
  }
}
