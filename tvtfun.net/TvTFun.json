      {
        "id": "4ee59258-e220-456c-aa04-b11239f712cb",
        "type": "node",
        "position": {
          "x": 620,
          "y": 620
        },
        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\n\n\ndef execute(node_id, node_data, context):\n    \"\"\"Parse anime detail: build chapters and pick the episode to resolve.\"\"\"\n    raw = context.get(\"response\") or \"\"\n    try:\n        payload = json.loads(raw)\n    except ValueError as exc:\n        raise ValueError(\"TvTFun detail did not return JSON\") from exc\n\n    data = payload.get(\"data\") or {}\n    seasons = data.get(\"seasons\") or []\n    chapters = []\n    episodes = []\n    for season in seasons:\n        season_name = str(season.get(\"name\") or \"\")\n        for episode in season.get(\"episodes\") or []:\n            eid = str(episode.get(\"id\") or \"\")\n            title = str(episode.get(\"title\") or \"\").strip()\n            if not eid:\n                continue\n            label = f\"{season_name} {title}\".strip() if season_name else title\n            chapters.append({\"id\": eid, \"title\": label})\n            episodes.append((eid, label))\n\n    requested = str(context.get(\"chapter_id\") or \"\").strip()\n    chosen = next((e for e in episodes if e[0] == requested), episodes[0] if episodes else None)\n\n    context[\"detail_chapters\"] = json.dumps(chapters)\n    context[\"detail_episode_id\"] = chosen[0] if chosen else \"\"\n    context[\"detail_episode_title\"] = chosen[1] if chosen else \"\"\n    context[\"detail_id\"] = str(data.get(\"slug\") or context.get(\"id\") or \"\")\n    context[\"detail_title\"] = str(data.get(\"name\") or \"\")\n    context[\"detail_cover\"] = data.get(\"coverUrl\") or data.get(\"posterUrl\") or \"\"\n    context[\"detail_desc\"] = str(data.get(\"summary\") or \"\")\n    context[\"detail_uploader\"] = str(data.get(\"studio\") or \"TvTFun\")\n    context[\"detail_year\"] = str(data.get(\"year\") or \"\")\n"
          }
