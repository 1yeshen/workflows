      {
        "id": "ce098e7a-3e09-4494-92f1-3451f2a3a158",
        "type": "node",
        "position": {
          "x": 700,
          "y": 300
        },
        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\n\n\ndef execute(node_id, node_data, context):\n    \"\"\"Parse the TvTFun search API response.\"\"\"\n    raw = context.get(\"response\") or \"\"\n    try:\n        payload = json.loads(raw)\n    except ValueError as exc:\n        raise ValueError(\"TvTFun did not return JSON\") from exc\n\n    body = payload.get(\"data\") if isinstance(payload.get(\"data\"), dict) else payload\n    items = body.get(\"items\") or []\n    results = []\n    for item in items:\n        slug = str(item.get(\"slug\") or \"\").strip()\n        name = str(item.get(\"name\") or \"\").strip()\n        if not slug or not name:\n            continue\n        misc = \" \\u00b7 \".join(\n            str(part) for part in (\n                item.get(\"year\"), item.get(\"season\"),\n                item.get(\"studio\"), item.get(\"status\"),\n            ) if part\n        )\n        results.append({\n            \"id\": slug,\n            \"title\": name,\n            \"cover\": item.get(\"coverUrl\") or item.get(\"posterUrl\") or \"\",\n            \"misc\": misc,\n            \"category\": \"番剧\",\n            \"uploader\": item.get(\"studio\") or \"TvTFun\",\n            \"uploaded_at\": str(item.get(\"updatedAt\") or item.get(\"publishAt\") or \"\")[:10],\n        })\n\n    page = int(context.get(\"page_num\") or 1)\n    size = int(context.get(\"page_size\") or 24)\n    total = body.get(\"total\")\n    try:\n        total_pages = (int(total) + size - 1) // size if total is not None else None\n    except (TypeError, ValueError):\n        total_pages = None\n\n    context[\"search_result\"] = json.dumps({\n        \"total\": total, \"totalPages\": total_pages, \"page\": page, \"items\": results,\n    })\n"
          }
        },
